'''Dynamic Type Tracker'''
'''To build this, we first need a variable where the user data would be stored
    We also need to use the while loop for the break functionality to work properly
    '''

inputs = []

while True:
    # collects user input in other to determine what type data user enters
    user_input = input('Enter any inputs (enter exit to exit): ')

    # allows users to enter new line when they enter exit input
    if user_input == 'exit':
        break

    # collects and stores user data 
    inputs.append(user_input)

    # prints user's values and data types
    print('value :', user_input)
    print('datatype :', type(user_input))

    if user_input == '':
        print('\nAll data collected : No data collected')

print('\nAll data collected : ', inputs)







       


